<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9"
    tools:context=".Admin">

    <LinearLayout
        android:id="@+id/seller_card"
        android:layout_width="146dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:background="@drawable/edittext_background"
        android:elevation="6dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/seller_card"
        app:layout_constraintStart_toEndOf="@+id/seller_card"
        app:layout_constraintTop_toTopOf="@+id/seller_card"
        app:layout_constraintVertical_bias="0.833">

        <TextView
            android:id="@+id/sd_stock_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lexend_medium"
            android:letterSpacing="-0.02"
            android:text="3"
            android:textAlignment="center"
            android:textColor="#3A1133"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/textView9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lexend_light"
            android:letterSpacing="-0.02"
            android:text="Buyers"
            android:textColor="#9A8596"
            android:textSize="11sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/adminTotalUserCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lexend_light"
        android:letterSpacing="-0.02"
        android:text="n Total Users"
        android:textAlignment="center"
        android:textColor="#9A8596"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/textView3"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />


    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lexend_medium"
        android:letterSpacing="-0.02"
        android:text="Admin Panel"
        android:textAlignment="textStart"
        android:textColor="#3A1133"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.097"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.068" />

    <LinearLayout
        android:id="@+id/seller_card"
        android:layout_width="146dp"
        android:layout_height="91dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edittext_background"
        android:elevation="6dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintStart_toStartOf="@+id/adminTotalUserCount"
        app:layout_constraintTop_toBottomOf="@+id/adminTotalUserCount">

        <TextView
            android:id="@+id/adminSellerCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lexend_medium"
            android:letterSpacing="-0.02"
            android:text="3"
            android:textAlignment="center"
            android:textColor="#3A1133"
            android:textSize="18sp" />


        <TextView
            android:id="@+id/textView8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lexend_light"
            android:letterSpacing="-0.02"
            android:text="Sellers"
            android:textAlignment="center"
            android:textColor="#9A8596"
            android:textSize="11sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/adminRecyclerView"
        android:layout_width="314dp"
        android:layout_height="443dp"
        android:layout_marginTop="28dp"
        app:layout_constraintEnd_toEndOf="@+id/seller_card"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/textView3"
        app:layout_constraintTop_toBottomOf="@+id/seller_card" />

</androidx.constraintlayout.widget.ConstraintLayout>