<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:context=".CartItemAdapter">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bg"
        android:layout_width="wrap_content"
        android:layout_height="107dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="4dp"
        android:background="@drawable/user_adapter_background"
        android:elevation="2dp"
        android:paddingHorizontal="30dp"
        android:paddingVertical="20dp"
        tools:context=".SellerProductAdapter"
        tools:layout_editor_absoluteX="-1dp"
        tools:layout_editor_absoluteY="0dp">

        <TextView
            android:id="@+id/ci_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lexend_light"
            android:letterSpacing="-0.02"
            android:text="Short Desc.."
            android:textAlignment="textStart"
            android:textColor="#9C8899"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@+id/ci_product_name"
            app:layout_constraintTop_toBottomOf="@+id/ci_product_name" />

        <TextView
            android:id="@+id/ci_desc2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="76dp"
            android:fontFamily="@font/lexend_light"
            android:letterSpacing="-0.02"
            android:text="Php 10.00"
            android:textAlignment="textStart"
            android:textColor="#FA5213"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@+id/pa_delete_button"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toEndOf="@+id/ci_qty"
            app:layout_constraintTop_toTopOf="@+id/ci_qty" />

        <TextView
            android:id="@+id/ci_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/pd_stock_bg"
            android:backgroundTint="#FA5213"
            android:fontFamily="@font/lexend_regular"
            android:letterSpacing="-0.02"
            android:paddingStart="10dp"
            android:paddingLeft="10dp"
            android:paddingTop="1dp"
            android:paddingEnd="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="1dp"
            android:textAlignment="textStart"
            android:textColor="#ffff"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@+id/ci_product_name"
            app:layout_constraintTop_toBottomOf="@+id/ci_desc"
            tools:text="15 in stock" />

        <TextView
            android:id="@+id/ci_product_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/lexend_medium"
            android:letterSpacing="-0.02"
            android:text="Product name"
            android:textAlignment="textStart"
            android:textColor="#3A1133"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@+id/pa_product_image"
            app:layout_constraintTop_toTopOf="@+id/pa_product_image" />

        <ImageButton
            android:id="@+id/pa_product_image"
            android:layout_width="56dp"
            android:layout_height="53dp"
            android:background="#f9f9f9"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/pa_delete_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="84dp"
            android:background="@null"
            android:scaleX="1.1"
            android:scaleY="1.1"
            android:src="@drawable/pa_delete_icon"
            app:layout_constraintStart_toEndOf="@+id/ci_product_name"
            app:layout_constraintTop_toTopOf="@+id/ci_product_name" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>