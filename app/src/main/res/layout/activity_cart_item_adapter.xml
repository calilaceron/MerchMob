<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        android:background="@drawable/user_adapter_background"
        android:elevation="4dp"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/pa_product_image"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="#f9f9f9"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="SpeakableTextPresentCheck" />

        <TextView
            android:id="@+id/ci_product_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/lexend_medium"
            android:letterSpacing="-0.02"
            android:text="Product Name"
            android:textColor="#3A1133"
            android:textSize="16sp"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@+id/pa_delete_button"
            app:layout_constraintStart_toEndOf="@+id/pa_product_image"
            app:layout_constraintTop_toTopOf="@+id/pa_product_image" />

        <TextView
            android:id="@+id/ci_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/lexend_light"
            android:letterSpacing="-0.02"
            android:text="Description goes here..."
            android:textColor="#9C8899"
            android:textSize="12sp"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@+id/pa_delete_button"
            app:layout_constraintStart_toStartOf="@+id/ci_product_name"
            app:layout_constraintTop_toBottomOf="@+id/ci_product_name" />

        <TextView
            android:id="@+id/ci_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/pd_stock_bg"
            android:backgroundTint="#FA5213"
            android:fontFamily="@font/lexend_regular"
            android:letterSpacing="-0.02"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="2 selected"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@+id/ci_product_name"
            app:layout_constraintTop_toBottomOf="@+id/ci_desc" />

        <TextView
            android:id="@+id/ci_desc2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lexend_medium"
            android:letterSpacing="-0.02"
            android:text="Php 000.00"
            android:textColor="#FA5213"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/ci_qty"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ci_qty" />

        <ImageButton
            android:id="@+id/pa_delete_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@null"
            android:scaleType="centerInside"
            android:src="@drawable/pa_delete_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="SpeakableTextPresentCheck" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>