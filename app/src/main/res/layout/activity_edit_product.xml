<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".EditProduct">

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:fontFamily="@font/lexend_medium"
        android:letterSpacing="-0.02"
        android:text="Edit Product"
        android:textAlignment="center"
        android:textColor="#755870"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/epBackButton"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginStart="20dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@+id/textView7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textView7"
        app:srcCompat="@drawable/back_icon"
        tools:ignore="SpeakableTextPresentCheck" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView7">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="40dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/apImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:background="@drawable/edittext_background"
                android:elevation="2dp"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.495"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/RoundedCorners"
                app:srcCompat="@drawable/change_product_photo" />

            <TextView
                android:id="@+id/textView14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/lexend_medium"
                android:letterSpacing="-0.02"
                android:text="Product Name"
                android:textColor="#3A1133"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="@+id/apProductName"
                app:layout_constraintTop_toBottomOf="@+id/apImageView" />

            <EditText
                android:id="@+id/apProductName"
                android:layout_width="318dp"
                android:layout_height="51dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/edittext_background"
                android:elevation="2dp"
                android:ems="10"
                android:fontFamily="@font/lexend_light"
                android:hint="Product Name"
                android:inputType="text"
                android:padding="15dp"
                android:textColor="#3A1133"
                android:textColorHint="#C4B8C2"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView14" />

            <TextView
                android:id="@+id/textView15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/lexend_medium"
                android:letterSpacing="-0.02"
                android:text="Price (PHP)"
                android:textColor="#3A1133"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="@+id/apPrice"
                app:layout_constraintTop_toBottomOf="@+id/apProductName" />

            <EditText
                android:id="@+id/apPrice"
                android:layout_width="318dp"
                android:layout_height="51dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/edittext_background"
                android:elevation="2dp"
                android:ems="10"
                android:fontFamily="@font/lexend_light"
                android:hint="Price (PHP)"
                android:inputType="numberDecimal"
                android:padding="15dp"
                android:textColor="#3A1133"
                android:textColorHint="#C4B8C2"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView15" />

            <TextView
                android:id="@+id/textView16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/lexend_medium"
                android:letterSpacing="-0.02"
                android:text="Stock"
                android:textColor="#3A1133"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="@+id/apStock"
                app:layout_constraintTop_toBottomOf="@+id/apPrice" />

            <EditText
                android:id="@+id/apStock"
                android:layout_width="318dp"
                android:layout_height="51dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/edittext_background"
                android:elevation="2dp"
                android:ems="10"
                android:fontFamily="@font/lexend_light"
                android:hint="Stock"
                android:inputType="number"
                android:padding="15dp"
                android:textColor="#3A1133"
                android:textColorHint="#C4B8C2"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView16" />

            <TextView
                android:id="@+id/textView17"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/lexend_medium"
                android:letterSpacing="-0.02"
                android:text="Description"
                android:textColor="#3A1133"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="@+id/apDescription"
                app:layout_constraintTop_toBottomOf="@+id/apStock" />

            <EditText
                android:id="@+id/apDescription"
                android:layout_width="316dp"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/edittext_background"
                android:elevation="2dp"
                android:ems="10"
                android:fontFamily="@font/lexend_light"
                android:gravity="top"
                android:hint="Description"
                android:inputType="textMultiLine"
                android:padding="15dp"
                android:textColor="#3A1133"
                android:textColorHint="#C4B8C2"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView17" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/apAddButton"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="192dp"
                android:layout_height="48dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/button_background"
                android:fontFamily="@font/lexend_regular"
                android:text="Save Edits"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/apDescription" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>