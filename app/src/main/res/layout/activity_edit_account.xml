<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9"
    tools:context=".EditAccount">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/editSaveButton"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="192dp"
        android:layout_height="48dp"
        android:layout_marginTop="35dp"
        android:background="@drawable/button_background"
        android:fontFamily="@font/lexend_regular"
        android:text="Save"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@+id/editDescription"
        app:layout_constraintHorizontal_bias="0.404"
        app:layout_constraintStart_toStartOf="@+id/editDescription"
        app:layout_constraintTop_toBottomOf="@+id/editDescription" />

    <TextView
        android:id="@+id/textView12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/lexend_medium"
        android:letterSpacing="-0.02"
        android:text="Password"
        android:textAlignment="textStart"
        android:textColor="#3A1133"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/textView11"
        app:layout_constraintTop_toBottomOf="@+id/editUsername" />

    <TextView
        android:id="@+id/textView13"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/lexend_medium"
        android:letterSpacing="-0.02"
        android:text="Description"
        android:textAlignment="textStart"
        android:textColor="#3A1133"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/textView11"
        app:layout_constraintTop_toBottomOf="@+id/editPassword" />

    <EditText
        android:id="@+id/editUsername"
        android:layout_width="268dp"
        android:layout_height="51dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/edittext_background"
        android:elevation="8dp"
        android:ems="10"
        android:fontFamily="@font/lexend_light"
        android:hint="Username"
        android:inputType="text"
        android:padding="15dp"
        android:textColorHint="#C4B8C2"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/textView11"
        app:layout_constraintTop_toBottomOf="@+id/textView11" />

    <EditText
        android:id="@+id/editPassword"
        android:layout_width="268dp"
        android:layout_height="51dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/edittext_background"
        android:elevation="8dp"
        android:ems="10"
        android:fontFamily="@font/lexend_light"
        android:hint="Password"
        android:inputType="text"
        android:padding="15dp"
        android:textColorHint="#C4B8C2"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/textView11"
        app:layout_constraintTop_toBottomOf="@+id/textView12" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/lexend_medium"
        android:letterSpacing="-0.02"
        android:text="Username"
        android:textAlignment="textStart"
        android:textColor="#3A1133"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/editBackButton"
        app:layout_constraintTop_toBottomOf="@+id/editImage" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:fontFamily="@font/lexend_medium"
        android:letterSpacing="-0.02"
        android:text="Edit Account"
        android:textAlignment="center"
        android:textColor="#755870"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/editBackButton"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginStart="56dp"
        android:layout_marginTop="32dp"
        android:background="#F9F9F9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/back_icon"
        tools:ignore="SpeakableTextPresentCheck" />

    <EditText
        android:id="@+id/editDescription"
        android:layout_width="267dp"
        android:layout_height="99dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/edittext_background"
        android:elevation="8dp"
        android:ems="10"
        android:fontFamily="@font/lexend_light"
        android:gravity="start|top"
        android:hint="Description"
        android:inputType="textMultiLine"
        android:padding="15dp"
        android:textColor="#8E1A7A"
        android:textColorHint="#C4B8C2"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/textView11"
        app:layout_constraintTop_toBottomOf="@+id/textView13" />

    <ImageView
        android:id="@+id/editImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        app:layout_constraintEnd_toEndOf="@+id/textView6"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="@+id/textView6"
        app:layout_constraintTop_toBottomOf="@+id/textView6"
        app:srcCompat="@drawable/edit_user_icon" />
</androidx.constraintlayout.widget.ConstraintLayout>