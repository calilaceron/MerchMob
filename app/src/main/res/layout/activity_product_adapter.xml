<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/user_adapter_background"
    android:elevation="2dp"
    android:paddingHorizontal="30dp"
    android:paddingVertical="20dp"
    tools:context=".SellerProductAdapter">

    <TextView
        android:id="@+id/pa_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lexend_light"
        android:letterSpacing="-0.02"
        android:text="Php Price"
        android:textAlignment="textStart"
        android:textColor="#9C8899"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@+id/pa_product_name"
        app:layout_constraintTop_toBottomOf="@+id/pa_product_name" />

    <TextView
        android:id="@+id/pa_stock_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/pd_stock_bg"
        android:fontFamily="@font/lexend_light"
        android:letterSpacing="-0.02"
        android:paddingStart="7dp"
        android:paddingLeft="7dp"
        android:paddingTop="1dp"
        android:paddingEnd="7dp"
        android:paddingRight="7dp"
        android:paddingBottom="1dp"
        android:textAlignment="textStart"
        android:textColor="#3A1133"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@+id/pa_product_name"
        app:layout_constraintTop_toBottomOf="@+id/pa_price"
        tools:text="15 in stock" />

    <TextView
        android:id="@+id/pa_product_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="@font/lexend_medium"
        android:letterSpacing="-0.02"
        android:text="Product name"
        android:textAlignment="textStart"
        android:textColor="#3A1133"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/pa_product_image"
        app:layout_constraintTop_toTopOf="@+id/pa_product_image" />

    <ImageButton
        android:id="@+id/pa_product_image"
        android:layout_width="56dp"
        android:layout_height="53dp"
        android:background="@null"
        android:src="@drawable/product_detail_img_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/pa_delete_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:background="@null"
        android:scaleX="1.1"
        android:scaleY="1.1"
        android:src="@drawable/pa_delete_icon"
        app:layout_constraintBottom_toBottomOf="@+id/pa_edit_button"
        app:layout_constraintStart_toEndOf="@+id/pa_edit_button"
        app:layout_constraintTop_toTopOf="@+id/pa_edit_button"
        app:layout_constraintVertical_bias="0.0" />

    <ImageButton
        android:id="@+id/pa_edit_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="136dp"
        android:background="@null"
        android:scaleX="1.1"
        android:scaleY="1.1"
        android:src="@drawable/pa_edit_icon"
        app:layout_constraintBottom_toBottomOf="@+id/pa_product_image"
        app:layout_constraintStart_toEndOf="@+id/pa_product_image"
        app:layout_constraintTop_toTopOf="@+id/pa_product_image"
        app:layout_constraintVertical_bias="0.458" />

</androidx.constraintlayout.widget.ConstraintLayout>